# Leave empty to run the agent offline with the scripted model (good for demos).
ANTHROPIC_API_KEY=
# Model used when ANTHROPIC_API_KEY is set.
VETAGENT_MODEL=claude-sonnet-5-5
# Fixed "today" so the demo data always shows the same care gaps.
VETAGENT_TODAY=2026-10-27
# SQLite file for app state (bookings, health log, consent, chat).
VETAGENT_DB=vetagent.db
