# Model provider: anthropic or openai.
VETAGENT_PROVIDER=anthropic
# Leave the chosen provider's key empty to run offline with the scripted model (good for demos).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model used when the provider's key is set. Empty picks the provider default
# (claude-sonnet-5-5 or gpt-5).
VETAGENT_MODEL=
# Fixed "today" so the demo data always shows the same care gaps.
VETAGENT_TODAY=2026-10-27
# SQLite file for app state (bookings, health log, consent, chat).
VETAGENT_DB=vetagent.db
